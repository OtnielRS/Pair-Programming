<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmation Pages</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6;
            color: #333;
            display: flex;
            flex-direction: column;
            align-items: center;
            margin: 0;
            padding: 40px 20px;
            min-height: 100vh;
        }
        h1 {
            color: #0056b3;
            font-size: 2.2rem;
            margin-bottom: 20px;
        }
        form {
            background-color: #ffffff;
            padding: 30px 40px;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
            width: 100%;
            max-width: 450px;
            box-sizing: border-box;
            font-size: 1rem;
            line-height: 1.6;
        }
        form p {
            display: inline-block;
            font-weight: 600;
            color: #444;
            width: 120px;
            margin: 10px 0;
        }
        form img {
            width: 100%;
            max-height: 200px;
            object-fit: cover;
            border-radius: 8px;
            margin-top: 10px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
        }
        input[type="submit"] {
            background-color: #28a745; /* Warna hijau untuk konfirmasi */
            color: white;
            padding: 14px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            width: 100%;
            font-size: 16px;
            font-weight: bold;
            transition: background-color 0.3s ease;
        }
        input[type="submit"]:hover {
            background-color: #218838;
        }
    </style>
</head>
<body>
    <%- include('../partial/navbar.ejs') %>
    <h1>Confirmation</h1>

    <form action="/booking/add/plane/<%= id %>/confirmation" method="POST">
        <p>Group Name</p> : <%= dataPesawat.groupName %> <br>
        <p>Class</p> : <%= dataPesawat.className %> <br>
        <p>Jumlah Kursi</p> : <%= dataPesawat.totalSeat %> <br>
        <p>Harga Tiket</p> : <%= dataPesawat.changeToRupiah %> <br>
        <p>Gambar Pesawat</p> : <br>
        <img src="<%= dataPesawat.imageUrl %>" alt=""><br>
        <input type="submit" name="submit" value="BETUL!"> <br>
    </form>
</body>
</html>